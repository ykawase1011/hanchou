{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanchou.dev/schemas/project-registry.v1.json",
  "title": "Hanchou machine-local project registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_policy"],
  "properties": {
    "schema_version": { "const": 1 },
    "default_policy": { "const": "deny" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "allowed_profiles"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
          "path": { "type": "string", "minLength": 1 },
          "allowed_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["work", "personal"] } },
          "default_leaf_role": { "enum": ["researcher", "implementer", "reviewer", "writer", "editor"] },
          "default_leaf_kind": { "enum": ["codex", "claude"] },
          "labels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "workspace_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "allowed_profiles", "trust"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
          "path": { "type": "string", "minLength": 1 },
          "allowed_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["work", "personal"] } },
          "trust": { "const": "descendant-git-repositories" }
        }
      }
    }
  }
}
