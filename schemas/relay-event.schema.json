{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanchou.dev/schemas/relay-event.v1.json",
  "title": "Hanchou Relay event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "type",
    "task_id",
    "execution_id",
    "from_agent",
    "from_role",
    "to_agent",
    "to_role",
    "delegation_depth",
    "created_at",
    "summary",
    "artifacts",
    "verification"
  ],
  "properties": {
    "schema": {
      "const": "hanchou.relay-event.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "type": {
      "enum": [
        "accepted",
        "checkpoint",
        "needs_decision",
        "blocked",
        "completed",
        "failed",
        "discovered_work",
        "schedule_proposal",
        "human_request",
        "schedule_due",
        "delivery_requested"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "from_agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "from_role": {
      "type": "string",
      "minLength": 1
    },
    "to_agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "to_role": {
      "type": "string",
      "minLength": 1
    },
    "delegation_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "detail_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recovery_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "from_state",
        "retry_count",
        "journal_schema"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "from_state": {
          "enum": [
            "processing",
            "dead-letter"
          ]
        },
        "retry_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "journal_schema": {
          "const": "hanchou.relay-inbox-transition-journal.v1"
        }
      }
    },
    "lease_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "recovery_count",
        "journal_schema"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "recovery_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "journal_schema": {
          "const": "hanchou.relay-inbox-transition-journal.v1"
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": true
    },
    "ack": {
      "type": "object",
      "additionalProperties": true
    },
    "dead_letter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "at",
        "reason"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "journal_schema": {
          "const": "hanchou.relay-terminal-journal.v1"
        }
      }
    }
  }
}
