{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanchou.dev/schemas/usage-snapshot.v1.json",
  "title": "Hanchou usage snapshot",
  "type": "object",
  "required": [
    "schema",
    "updated_at",
    "providers"
  ],
  "properties": {
    "schema": {
      "const": "hanchou.usage-snapshot.v1"
    },
    "updated_at": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "required": [
        "codex",
        "claude"
      ],
      "additionalProperties": false,
      "properties": {
        "codex": {
          "$ref": "#/$defs/provider"
        },
        "claude": {
          "$ref": "#/$defs/provider"
        }
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": [
        "source",
        "weekly_remaining_percent"
      ],
      "properties": {
        "source": {
          "enum": [
            "manual",
            "probe",
            "unknown"
          ]
        },
        "weekly_remaining_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "session_remaining_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reset_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
