{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanchou.dev/schemas/task-metadata.v1.json",
  "title": "Hanchou task metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "project",
    "execution_mode",
    "owner_role",
    "owner_agent"
  ],
  "properties": {
    "schema": {
      "const": "hanchou.task.v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repo_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_mode": {
      "enum": [
        "direct",
        "leaf",
        "mission"
      ]
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "owner_agent": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "herdr": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "session",
        "agent_name",
        "kind",
        "binding_state"
      ],
      "properties": {
        "session": {
          "type": "string"
        },
        "agent_name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pane_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "binding_state": {
          "enum": [
            "pending",
            "live",
            "settled",
            "released",
            "lost"
          ]
        }
      }
    },
    "automation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "relation"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "created-by",
            "tracks",
            "result-of"
          ]
        },
        "last_run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "routing": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "role",
        "task_kind",
        "provider",
        "model",
        "reason"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "task_kind": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "codex",
            "claude"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "usage_snapshot_updated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reporting": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "policy",
        "renderer",
        "destination",
        "coalesce"
      ],
      "properties": {
        "policy": {
          "enum": [
            "silent",
            "parent_only",
            "on_failure",
            "on_change",
            "on_terminal",
            "always",
            "digest",
            "immediate"
          ]
        },
        "renderer": {
          "enum": [
            "orchestrator",
            "editor",
            "producer"
          ]
        },
        "destination": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "local_session",
                "origin",
                "slack_channel",
                "slack_thread",
                "discord_channel",
                "discord_thread",
                "file"
              ]
            }
          }
        },
        "coalesce": {
          "enum": [
            "none",
            "root_task",
            "time_window",
            "digest"
          ]
        },
        "digest_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
