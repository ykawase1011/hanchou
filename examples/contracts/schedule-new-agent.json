{
  "schema": "hanchou.schedule.v1",
  "name": "daily-triage",
  "profile": "work",
  "cron": "0 9 * * 1-5",
  "timezone": "Asia/Tokyo",
  "target_mode": "new-agent",
  "project": "hanchou",
  "repo": "/Users/example/Workspace/Repositories/hanchou",
  "workspace": "worktree",
  "role": "researcher",
  "agent": "claude",
  "model": "sonnet",
  "prompt": "Triage new issues and write a concise report.",
  "workflow": null,
  "mcp_config": null,
  "agent_args": [],
  "timeout_minutes": 60,
  "catch_up_minutes": 120,
  "overlap_policy": "skip-same",
  "task_link_policy": "new-run-task",
  "task_id": null,
  "enabled": false,
  "metadata": {},
  "reporting": {
    "policy": "on_change",
    "renderer": "orchestrator",
    "destination": {
      "type": "local_session",
      "agent": "orchestrator"
    },
    "coalesce": "time_window",
    "digest_key": null,
    "change_key": "daily-triage-result"
  }
}
