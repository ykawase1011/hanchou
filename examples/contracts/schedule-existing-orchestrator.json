{
  "schema": "hanchou.schedule.v1",
  "name": "daily-orchestrator-review",
  "profile": "work",
  "cron": "0 10 * * 1-5",
  "timezone": "Asia/Tokyo",
  "target_mode": "existing-orchestrator",
  "project": "hanchou-control",
  "repo": null,
  "workspace": "none",
  "role": "orchestrator",
  "agent": null,
  "model": null,
  "prompt": "Review ready, blocked, and in-progress Beads and continue only actionable work.",
  "workflow": null,
  "mcp_config": null,
  "agent_args": [],
  "timeout_minutes": 30,
  "catch_up_minutes": 120,
  "overlap_policy": "skip-same",
  "task_link_policy": "existing-parent",
  "task_id": "hch-control-review",
  "enabled": false,
  "metadata": {},
  "reporting": {
    "policy": "always",
    "renderer": "orchestrator",
    "destination": {
      "type": "local_session",
      "agent": "orchestrator"
    },
    "coalesce": "none",
    "digest_key": null,
    "change_key": null
  }
}
