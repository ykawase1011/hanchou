automations:
  - name: hch-personal-daily-digest-source
    cron: "0 9 * * *"
    repo: {{REPO_ROOT}}
    workspace: root
    agent: codex
    model: gpt-5.6-terra
    prompt: |
      Collect bounded Beads, Herdr, Automation-history, Decision, and usage data.
      Write a source report to {{REPORT_DIR}} and emit a schedule_due Relay event
      to orchestrator. Do not perform new project research or directly publish
      the final digest.
    timeout_minutes: 30
    catch_up_minutes: 240
    disabled: true
