# Project-local policy for the trusted Hanchou L0 checkout. The CLI validates
# record IDs, lease ownership, expiry, and the managed Agent identity before a
# mutating Inbox transition is accepted.

# Project authorization is human-owned machine-local state. Managed Agents may
# inspect and resolve it. `hanchou onboard --yes` expands trust, so it is
# intentionally not allowlisted and is restricted to a human interactive shell.
prefix_rule(
    pattern = [["hanchou", "./bin/hanchou", "bin/hanchou"], ["init", "update", "rollback"]],
    decision = "prompt",
    justification = "Installing or switching the profile-local Hanchou supply chain requires exact human-reviewed commits",
    match = [
        "hanchou init work",
        "hanchou init work --plan 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --yes",
        "./bin/hanchou update",
        "./bin/hanchou update --plan 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --yes",
        "./bin/hanchou rollback",
    ],
)

prefix_rule(
    pattern = [["hanchou", "./bin/hanchou", "bin/hanchou"], "stop-orchestrator"],
    decision = "prompt",
    justification = "Stopping the Orchestrator terminates validated workspace PTYs; this prompt is defense in depth for human review",
    match = [
        "hanchou stop-orchestrator work --all",
        "hanchou stop-orchestrator work --all --plan 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --yes",
        "./bin/hanchou stop-orchestrator --all",
        "./bin/hanchou stop-orchestrator --all --plan 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef --yes",
    ],
)

prefix_rule(
    pattern = [["hanchou", "./bin/hanchou", "bin/hanchou"], "project", ["list", "show", "resolve", "doctor"]],
    decision = "allow",
    justification = "Read and validate the human-owned Hanchou project authorization registry",
    match = [
        "hanchou project list --json",
        "./bin/hanchou project list --json",
        "hanchou project show example-app --json",
        "hanchou project resolve --path /workspace/example-app --json",
        "hanchou project doctor",
    ],
    not_match = [
        "hanchou project add example-app --path /workspace/example-app",
        "hanchou project trust-root work --path /workspace",
    ],
)

prefix_rule(
    pattern = [["hanchou", "./bin/hanchou", "bin/hanchou"], "inbox", ["list", "show"]],
    decision = "allow",
    justification = "Read validated Hanchou Inbox records in the L0 control repository",
    match = [
        "hanchou inbox list --json",
        "./bin/hanchou inbox list --json",
        "hanchou inbox show evt_example",
    ],
    not_match = [
        "hanchou inbox claim --json",
        "hanchou --profile work inbox list --json",
    ],
)

prefix_rule(
    pattern = [["hanchou", "./bin/hanchou", "bin/hanchou"], "inbox", ["claim", "ack"]],
    decision = "allow",
    justification = "Perform validated identity-bound routine Inbox transitions",
    match = [
        "hanchou inbox claim --to orchestrator --json",
        "./bin/hanchou inbox claim --to orchestrator --json",
        "hanchou inbox ack evt_example --by orchestrator",
    ],
    not_match = [
        "hanchou inbox retry evt_example",
        "hanchou inbox dead-letter evt_example --reason invalid",
    ],
)

prefix_rule(
    pattern = [["hanchou", "./bin/hanchou", "bin/hanchou"], "inbox", ["retry", "dead-letter"]],
    decision = "prompt",
    justification = "Retry and dead-letter alter delivery semantics and require operator review",
    match = [
        "hanchou inbox retry evt_example",
        "./bin/hanchou inbox retry evt_example",
        "hanchou inbox dead-letter evt_example --reason invalid",
    ],
    not_match = [
        "hanchou inbox list --json",
        "hanchou inbox future-command",
    ],
)
