<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.hanchou.{{PROFILE}}.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_BIN}}</string>
    <string>--experimental-strip-types</string>
    <string>{{HANCHOU_ENTRY}}</string>
    <string>dashboard</string>
    <string>serve</string>
    <string>{{PROFILE}}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{CONTROL_DIR}}</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{{PATH}}</string>
    <key>HANCHOU_PROFILE</key><string>{{PROFILE}}</string>
    <key>HANCHOU_DASHBOARD_HOST</key><string>{{HOST}}</string>
    <key>HANCHOU_DASHBOARD_PORT</key><string>{{PORT}}</string>
    <key>HANCHOU_SERVICE_FINGERPRINT</key><string>{{FINGERPRINT}}</string>
    <key>HANCHOU_HOME</key><string>{{STATE_ROOT}}</string>
    <key>HANCHOU_CONFIG_ROOT</key><string>{{CONFIG_ROOT}}</string>
    <key>HANCHOU_CORE_ROOT</key><string>{{CORE_ROOT}}</string>
    <key>HANCHOU_WORKSPACE_ROOT</key><string>{{WORKSPACE_ROOT}}</string>
    <key>HANCHOU_INSTANCE_ROOT</key><string>{{INSTANCE_ROOT}}</string>
    <key>HANCHOU_INSTANCE_PROFILE</key><string>{{INSTANCE_PROFILE}}</string>
    <key>HANCHOU_BEADS_DIR</key><string>{{BEADS_DIR}}</string>
    <key>HANCHOU_RELAY_DIR</key><string>{{RELAY_DIR}}</string>
    <key>BEADS_DIR</key><string>{{BEADS_DIR}}</string>
    <key>BD_AGENT_PROFILE</key><string>conservative</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{{STATE_ROOT}}/logs/dashboard.out.log</string>
  <key>StandardErrorPath</key><string>{{STATE_ROOT}}/logs/dashboard.err.log</string>
</dict>
</plist>
